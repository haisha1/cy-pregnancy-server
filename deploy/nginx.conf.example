# 放入现有Nginx的HTTPS server块；域名、证书和小程序request合法域名由部署环境提供。
# 默认关闭API访问日志，避免未来误把分享凭据/查询参数带入日志。
location /api/ {
    access_log off;
    proxy_pass http://127.0.0.1:18731;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_connect_timeout 5s;
    proxy_read_timeout 30s;
    client_max_body_size 3m;
}
# 当前按应用看到的连接地址限流。经过Nginx后所有用户共享该窗口，公网开放前须配置
# Nginx按真实来源限流，并在Java中只信任指定代理传递的来源地址，见部署文档。
